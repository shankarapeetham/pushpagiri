rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 48th Peetadhipatulu live darshan photos
    match /peethadipathi_photos/{allPaths=**} {
      // Devotees worldwide can view holy photos publicly
      allow read: if true;
      
      // Only authenticated admins can upload or delete photos
      // Enforces image content-type and max file size 15MB
      allow write: if request.auth != null
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // General peetham assets
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Default deny for all other files
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
